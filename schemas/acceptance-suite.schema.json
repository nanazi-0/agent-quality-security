{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent acceptance suite",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "name": {"type": "string"},
    "policy": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "risk", "invoke"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "invoke": {"type": "object", "required": ["url"]},
          "response_assertions": {"type": "array"},
          "outcome": {"type": "array"}
        }
      }
    }
  }
}

